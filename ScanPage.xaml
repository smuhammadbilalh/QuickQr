<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
                          xmlns:local="clr-namespace:QuickQr"
             x:Class="QuickQr.ScanPage"
              Title="QuickQr"         
 BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
 Shell.NavBarIsVisible="True"
 Shell.BackgroundColor = "{AppThemeBinding Light=White, Dark=Black}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{AppThemeBinding Light=White, Dark=Black}"
                                 StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}"/>
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Light Theme Colors -->
            <Color x:Key="LightCard">#FFFFFF</Color>
            <Color x:Key="LightPrimary">#4A6CF7</Color>
            <Color x:Key="LightSecondary">#64748B</Color>
            <Color x:Key="LightTextPrimary">#1E293B</Color>
            <Color x:Key="LightTextSecondary">#475569</Color>
            <Color x:Key="LightAccent">#0EA5E9</Color>
            <Color x:Key="LightSuccess">#10B981</Color>
            <Color x:Key="BackgroundLight">#FAFBFF</Color>

            <!-- Dark Theme Colors -->
            <Color x:Key="DarkCard">#1E293B</Color>
            <Color x:Key="BackgroundDark">#0A0A0B</Color>
            <Color x:Key="DarkPrimary">#6366F1</Color>
            <Color x:Key="DarkSecondary">#94A3B8</Color>
            <Color x:Key="DarkTextPrimary">#F1F5F9</Color>
            <Color x:Key="DarkTextSecondary">#CBD5E1</Color>
            <Color x:Key="DarkAccent">#38BDF8</Color>
            <Color x:Key="DarkSuccess">#34D399</Color>

            <LinearGradientBrush x:Key="AccentGradientLight" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#06B6D4" Offset="0" />
                <GradientStop Color="#8B5CF6" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentGradientDark" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#22D3EE" Offset="0" />
                <GradientStop Color="#A78BFA" Offset="1" />
            </LinearGradientBrush>

            <!-- Converter -->
            <local:InverseBoolConverter x:Key="InverseBoolConverter" />

            <!-- Styles -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextTransform" Value="Uppercase" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextTransform" Value="None" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}" />
                <Setter Property="BorderWidth" Value="2" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="AccentButton" TargetType="Button">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextTransform" Value="Uppercase" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}" />
                <Setter Property="TextColor" Value="White" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Top Border - Now in its own row -->
        <Border Grid.Row="0"
                HeightRequest="2"
                Margin="10,0,10,0"
                Background="{AppThemeBinding Light={StaticResource AccentGradientLight}, Dark={StaticResource AccentGradientDark}}"
                StrokeThickness="0"
                VerticalOptions="Start">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" BackgroundColor="{AppThemeBinding Light=White, Dark=Black}">
            <ScrollView>
                <VerticalStackLayout Spacing="30" Padding="20">
                    <!-- Header Section -->
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="QR SCANNER"
                               FontSize="28"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}" />

                        <Label Text="Scan QR codes instantly"
                               FontSize="14"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource LightSecondary}, Dark={StaticResource DarkSecondary}}" />
                    </VerticalStackLayout>

                    <!-- Scanner Card -->
                    <Frame CornerRadius="24"
                           Padding="0"
                           BorderColor="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                           BackgroundColor="{AppThemeBinding Light={StaticResource LightCard}, Dark={StaticResource DarkCard}}"
                           HasShadow="True"
                           Shadow="{AppThemeBinding Light={Shadow Brush=#10600000, Offset='0,0.16', Radius=5}, 
                                                  Dark={Shadow Brush=#40FFFFFF, Offset='0,0.10', Radius=5}}">
                        <VerticalStackLayout x:Name="ScannerContainer" Spacing="20" Padding="25">
                            <!-- Scanner Options -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                                <Button Text="Camera Scan"
                                        Grid.Column="0"
                                        Style="{StaticResource PrimaryButton}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"
                                        TextColor="White"
                                        x:Name="StartScanButton"
                                        Clicked="OnStartScanClicked"/>

                                <Button Text="File Scan"
                                        Grid.Column="1"
                                        Style="{StaticResource SecondaryButton}"
                                        x:Name="ScanFileButton"
                                        Clicked="OnScanFileClicked"/>
                            </Grid>

                            <!-- Dynamic Camera Scanner Container - This will be populated dynamically -->

                            <!-- Scanner Instructions -->
                            <VerticalStackLayout x:Name="ScannerInstructions"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                Spacing="10">
                                <Image Source="scan_icon.png"
                                       HeightRequest="100"
                                       WidthRequest="100"
                                       HorizontalOptions="Center"/>

                                <Label Text="Ready to scan"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>

                                <Label Text="Tap 'Camera Scan' to start scanning QR codes"
                                       FontSize="14"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource LightSecondary}, Dark={StaticResource DarkSecondary}}"/>
                            </VerticalStackLayout>

                            <!-- Scanned Result Section -->
                            <Frame CornerRadius="16"
                                   BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#334155}"
                                   Padding="20"
                                   IsVisible="{Binding HasScannedResult}">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="Scan Result"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"/>

                                    <BoxView HeightRequest="1"
                                             BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                             Margin="0,0,0,10"/>

                                    <Label x:Name="ScannedResultLabel"
                                           Text="{Binding ScannedResult}"
                                           FontSize="14"
                                           LineBreakMode="WordWrap"/>

                                    <Button Text="Copy Result"
                                            Style="{StaticResource AccentButton}"
                                            Margin="0,10,0,0"
                                            Clicked="OnCopyResultClicked"/>
                                </VerticalStackLayout>
                            </Frame>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Tips Section -->
                    <Frame CornerRadius="24"
                           Padding="0"
                           BorderColor="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                           BackgroundColor="{AppThemeBinding Light={StaticResource LightCard}, Dark={StaticResource DarkCard}}"
                           HasShadow="True"
                           Shadow="{AppThemeBinding Light={Shadow Brush=#10600000, Offset='0,0.16', Radius=5}, 
                                                  Dark={Shadow Brush=#40FFFFFF, Offset='0,0.10', Radius=5}}">
                        <VerticalStackLayout Spacing="15" Padding="25">
                            <Label Text="Scanning Tips"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"/>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                                <Label FontSize="20" Text="&#xea24;" VerticalTextAlignment="Center"
         FontFamily="MaterialIcons" />
                                <Label Grid.Column="1"
                                       Text="Ensure the QR code is well-lit and centered in the frame"
                                       FontSize="14"
                                       VerticalTextAlignment="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                                <Label FontSize="20" Text="&#xea24;" VerticalTextAlignment="Center" 
FontFamily="MaterialIcons" />
                                <Label Grid.Column="1"
                                       Text="Avoid reflections and glare on the code surface"
                                       FontSize="14"
                                       VerticalTextAlignment="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                                <Label  FontSize="20" Text="&#xea24;"  VerticalTextAlignment="Center"
FontFamily="MaterialIcons" />
                                <Label Grid.Column="1"
                                       Text="Hold your device steady for best recognition"
                                       FontSize="14"
                                       VerticalTextAlignment="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Progress Ring Overlay -->
        <Grid x:Name="ProgressOverlay" 
              Grid.RowSpan="2"
              IsVisible="True"
              BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
              ZIndex="999">
            <ActivityIndicator x:Name="PageLoadingIndicator"
                              IsRunning="True"
                              Color="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"
                              HeightRequest="50"
                              WidthRequest="50"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>