<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:local="clr-namespace:QuickQr"
             x:Class="QuickQr.MainPage"
             Title="QuickQr"         
             BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
             Shell.NavBarIsVisible="True"
             Shell.BackgroundColor = "{AppThemeBinding Light=White, Dark=Black}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{AppThemeBinding Light=White, Dark=Black}"
                                   StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}"/>
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Light Theme Colors -->
            <Color x:Key="LightCard">#FFFFFF</Color>
            <Color x:Key="LightPrimary">#4A6CF7</Color>
            <Color x:Key="LightSecondary">#64748B</Color>
            <Color x:Key="LightTextPrimary">#1E293B</Color>
            <Color x:Key="LightTextSecondary">#475569</Color>
            <Color x:Key="LightAccent">#0EA5E9</Color>
            <Color x:Key="BackgroundLight">#FAFBFF</Color>

            <!-- Dark Theme Colors -->
            <Color x:Key="DarkCard">#1E293B</Color>
            <Color x:Key="BackgroundDark">#0A0A0B</Color>
            <Color x:Key="DarkPrimary">#6366F1</Color>
            <Color x:Key="DarkSecondary">#94A3B8</Color>
            <Color x:Key="DarkTextPrimary">#F1F5F9</Color>
            <Color x:Key="DarkTextSecondary">#CBD5E1</Color>
            <Color x:Key="DarkAccent">#38BDF8</Color>

            <LinearGradientBrush x:Key="AccentGradientLight" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#06B6D4" Offset="0" />
                <GradientStop Color="#8B5CF6" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentGradientDark" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#22D3EE" Offset="0" />
                <GradientStop Color="#A78BFA" Offset="1" />
            </LinearGradientBrush>

            <!-- Converter -->
            <local:InverseBoolConverter x:Key="InverseBoolConverter" />

            <!-- Styles -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource LightSecondary}, Dark={StaticResource DarkSecondary}}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightCard}, Dark={StaticResource DarkCard}}" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
                <Setter Property="ReturnType" Value="Done" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextTransform" Value="Uppercase" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextTransform" Value="None" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}" />
                <Setter Property="BorderWidth" Value="2" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Main Container with proper structure -->
    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Border - Now properly positioned -->
        <Border Grid.Row="0"
                HeightRequest="2"
                Margin="10,0,10,0"
                Background="{AppThemeBinding Light={StaticResource AccentGradientLight}, Dark={StaticResource AccentGradientDark}}"
                StrokeThickness="0"
                VerticalOptions="Start">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="2" />
            </Border.StrokeShape>
        </Border>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <Grid Padding="20,30,20,20" RowSpacing="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Section -->
                <VerticalStackLayout Grid.Row="0" Spacing="8" HorizontalOptions="Center">
                    <Label Text="QR GENERATOR" 
                           FontSize="28"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}" />

                    <Label Text="Transform text into scannable codes" 
                           FontSize="14"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource LightSecondary}, Dark={StaticResource DarkSecondary}}" />
                </VerticalStackLayout>

                <!-- Main Card -->
                <Frame Grid.Row="1" 
                       CornerRadius="15"
                       Padding="0"
                       BorderColor="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource LightCard}, Dark={StaticResource DarkCard}}"
                       HasShadow="True"
                       Shadow="{AppThemeBinding Light={Shadow Brush=#10600000, Offset='0,0.16', Radius=5}, 
                                              Dark={Shadow Brush=#40FFFFFF, Offset='0,0.10', Radius=5}}">

                    <VerticalStackLayout Spacing="20" Padding="25">
                        <!-- Input Section -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Enter Content" 
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource LightSecondary}, Dark={StaticResource DarkSecondary}}" />

                            <Entry Placeholder="Text, URL, or data"
                                   x:Name="TextEntry"
                                   Text="{Binding InputText}"
                                   Completed="OnGenerateClicked"/>
                        </VerticalStackLayout>

                        <!-- Generate Button -->
                        <Button Text="Generate QR Code" 
                                x:Name="GenerateButton"
                                Clicked="OnGenerateClicked"
                                Style="{StaticResource PrimaryButton}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"
                                TextColor="White" />

                        <!-- Replace your QR Code Display section with this improved version -->
                        <Grid VerticalOptions="Center" HorizontalOptions="Center" 
      HeightRequest="280" WidthRequest="280"
      Padding="15">

                            <!-- Background Pattern -->
                            <BoxView CornerRadius="16"
             BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#334155}" />

                            <!-- Placeholder Content (when no QR code) -->
                            <VerticalStackLayout x:Name="PlaceholderContent"
                         HorizontalOptions="Center" 
                         VerticalOptions="Center"
                         Spacing="15"
                         IsVisible="{Binding Source={x:Reference QrCodeImage}, Path=IsVisible, Converter={StaticResource InverseBoolConverter}}">

                                <!-- Up Arrow Icon -->
                                <Label Text="&#xe5d8;" 
               FontFamily="MaterialIcons"
               FontSize="48"
               TextColor="{AppThemeBinding Light={StaticResource LightSecondary}, Dark={StaticResource DarkSecondary}}"
               HorizontalOptions="Center"
               Rotation="0"/>

                                <!-- Placeholder Text -->
                                <Label Text="Enter Text to Generate" 
               FontSize="16"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light={StaticResource LightSecondary}, Dark={StaticResource DarkSecondary}}"
               HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <!-- QR Code Container - CRITICAL CHANGES HERE -->
                            <Frame CornerRadius="16" 
           Padding="10"
           IsVisible="{Binding Source={x:Reference QrCodeImage}, Path=IsVisible}"
           BackgroundColor="Transparent"
           HasShadow="False"
           BorderColor="Transparent">

                                <!-- CRITICAL: Wrap Image in its own isolated container -->
                                <Border BackgroundColor="White" 
                StrokeThickness="0"
                Padding="5">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>

                                    <!-- CRITICAL: Add specific properties to isolate rendering -->
                                    <Image x:Name="QrCodeImage" 
                   HeightRequest="220"
                   WidthRequest="220"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   BackgroundColor="White"
                   IsAnimationPlaying="False"
                   />
                                </Border>
                            </Frame>

                            <!-- Loading Overlay -->
                            <Frame x:Name="LoadingOverlay"
           CornerRadius="16"
           Padding="20"
           IsVisible="False"
           BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkCard}}"
           HasShadow="False">
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">
                                    <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="True"
                               Color="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"
                               HeightRequest="40"
                               WidthRequest="40" />
                                    <Label Text="Generating QR Code..." 
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                   HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- Action Buttons -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" >
                            <Button Text="Save" 
                                    Grid.Column="0"
                                    Clicked="OnSaveClicked"
                                    Style="{StaticResource SecondaryButton}"/>

                            <Button Text="Share" 
                                    Grid.Column="1"
                                    Clicked="OnShareClicked"
                                    Style="{StaticResource SecondaryButton}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </Grid>
        </ScrollView>

        <!-- Progress Ring Overlay -->
        <Grid x:Name="ProgressOverlay" 
              Grid.RowSpan="2"
              IsVisible="True"
              BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
              ZIndex="999">
            <ActivityIndicator x:Name="PageLoadingIndicator"
                              IsRunning="True"
                              Color="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"
                              HeightRequest="50"
                              WidthRequest="50"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>