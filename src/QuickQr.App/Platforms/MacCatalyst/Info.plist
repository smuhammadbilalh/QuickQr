<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Secure QR uses AES via the platform crypto libraries, which is exempt (standard encryption for user data). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>

	<!-- Privacy usage descriptions -->
	<key>NSCameraUsageDescription</key>
	<string>QuickQr uses the camera to scan QR codes and barcodes. Images are processed on your Mac and never uploaded.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>QuickQr saves the codes you create to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>QuickQr reads the photo you choose to find QR codes and barcodes in it.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>QuickQr uses Touch ID to unlock the app when App lock is on.</string>

	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>whatsapp</string>
		<string>tg</string>
		<string>bitcoin</string>
		<string>ethereum</string>
		<string>litecoin</string>
		<string>upi</string>
	</array>
</dict>
</plist>
