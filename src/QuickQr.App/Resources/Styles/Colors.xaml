<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
  QuickQr design tokens. Use the semantic keys (Surface, OnSurface, Card, Border, ...) through
  AppThemeBinding pairs, e.g. {AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}.
  Android splash/status colours: Platforms/Android/Resources/values*/colors.xml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand -->
    <Color x:Key="Primary">#6366F1</Color>
    <Color x:Key="PrimaryDark">#818CF8</Color>
    <Color x:Key="PrimaryVariant">#4F46E5</Color>
    <Color x:Key="Secondary">#8B5CF6</Color>
    <Color x:Key="SecondaryDark">#A78BFA</Color>
    <Color x:Key="Accent">#06B6D4</Color>
    <Color x:Key="AccentDark">#22D3EE</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>

    <!-- Status -->
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Danger">#EF4444</Color>
    <Color x:Key="Info">#3B82F6</Color>
    <Color x:Key="SuccessSoftLight">#D1FAE5</Color>
    <Color x:Key="SuccessSoftDark">#064E3B</Color>
    <Color x:Key="WarningSoftLight">#FEF3C7</Color>
    <Color x:Key="WarningSoftDark">#78350F</Color>
    <Color x:Key="DangerSoftLight">#FEE2E2</Color>
    <Color x:Key="DangerSoftDark">#7F1D1D</Color>

    <!-- Premium -->
    <Color x:Key="Premium">#F59E0B</Color>
    <Color x:Key="PremiumDeep">#D97706</Color>

    <!-- Surfaces (light) -->
    <Color x:Key="BackgroundLight">#F8FAFC</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardAltLight">#F1F5F9</Color>
    <Color x:Key="BorderLight">#E2E8F0</Color>
    <Color x:Key="OnSurfaceLight">#0F172A</Color>
    <Color x:Key="OnSurfaceMutedLight">#64748B</Color>
    <Color x:Key="PrimarySoftLight">#EEF2FF</Color>

    <!-- Surfaces (dark) -->
    <Color x:Key="BackgroundDark">#0A0A0B</Color>
    <Color x:Key="SurfaceDark">#111113</Color>
    <Color x:Key="CardDark">#18181B</Color>
    <Color x:Key="CardAltDark">#232327</Color>
    <Color x:Key="BorderDark">#2E2E33</Color>
    <Color x:Key="OnSurfaceDark">#F1F5F9</Color>
    <Color x:Key="OnSurfaceMutedDark">#A1A1AA</Color>
    <Color x:Key="PrimarySoftDark">#1E1B4B</Color>

    <!-- Neutral scale (kept for template styles) -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScanGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#06B6D4" Offset="0" />
        <GradientStop Color="#0891B2" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PremiumGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F59E0B" Offset="0" />
        <GradientStop Color="#EC4899" Offset="1" />
    </LinearGradientBrush>

    <!-- Shadows -->
    <Shadow x:Key="CardShadow" Brush="Black" Offset="0,4" Radius="12" Opacity="0.08" />
    <Shadow x:Key="ButtonShadow" Brush="#6366F1" Offset="0,4" Radius="14" Opacity="0.25" />
</ResourceDictionary>
